# ============================================================
#  Hop & Bites POS — Pi configuratie
#
#  Dit bestand staat op de FAT-bootpartitie: na het flashen kun
#  je het vanaf Windows/macOS bewerken (verschijnt als "bootfs").
#  Na elke wijziging: SD-kaart terug in de Pi en (her)starten.
#  De Pi leest dit bestand bij ELKE boot opnieuw in.
#
#  Resultaat/foutmeldingen: zie STATUS.txt in deze map.
# ============================================================

# --- VERPLICHT: tenant + venue (UUID's uit Supabase) ---
ORG_ID=
VENUE_ID=

# --- VERPLICHT: Supabase (shared project) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publieke (anon) key — nodig voor de web-app die lokaal op de Pi draait.
SUPABASE_ANON_KEY=

# --- myPOS PIN ---
#   off    PIN uitgeschakeld (standaard). De rest van de kassa werkt gewoon.
#   cloud  Via de myPOS ePOS API. myPOS duwt het bedrag naar de terminal, die
#          de kaart autoriseert via zijn eigen simkaart.
#
# LET OP: cloud vereist internet op de Pi. De standaardwerkwijze is een
# telefoon aan de USB-poort met USB-tethering aan — zie "Internet" hieronder.
# Alleen de API-aanroep gaat daarover; het betaalverkeer zelf loopt via de
# simkaart van de terminal. De terminal rechtstreeks over het LAN aansturen is
# onderzocht en werkt niet; zie raspberry-pos-os/README.md.
#
# Valt de verbinding weg midden in een betaling, dan zegt de kassa "controleer
# de terminal" in plaats van te gokken. Zodra er weer verbinding is zoekt de
# Pi de betaling zelf op (op referentienummer) en pakt de status alsnog op.
MYPOS_TRANSPORT=off

# Gateway: demo tijdens testen, productie voor echt geld.
#   https://demo-api-gateway.mypos.com   (testen)
#   https://api-gateway.mypos.com        (productie)
MYPOS_GATEWAY_URL=https://api-gateway.mypos.com

# Partner Portal -> Integrations -> jouw Smart POS-integratie -> Summary.
MYPOS_PARTNER_ID=
MYPOS_APPLICATION_ID=
# Partner Portal -> Generate API Credentials. Het secret zie je maar EEN keer.
MYPOS_INTEGRATION_CLIENT_ID=
MYPOS_INTEGRATION_CLIENT_SECRET=

# Partner Portal -> Merchants, nadat de merchant de integratie heeft goedgekeurd.
MYPOS_MERCHANT_CLIENT_ID=
MYPOS_MERCHANT_CLIENT_SECRET=

# Terminal-ID waar de betaling heen moet. Op te vragen met
# `node apps/pi-bridge/scripts/mypos-pay.mjs --terminals`, of af te lezen op de
# terminal onder Settings -> About Terminal.
MYPOS_TID=
# Operatorcode op de bon (max 4 tekens).
MYPOS_OPERATOR_CODE=1

# --- Bonprinter (netwerkprinter in de truck) ---
PRINTER_NETWORK_ADDR=192.168.1.50
PRINTER_TYPE=star

# Logo bovenaan de klantbon: zet een bestand "logo.png" in deze map
# (pos-setup) op de bootpartitie. Bij de eerstvolgende start staat het op de
# bon; weghalen betekent geen logo meer.
#
# Een thermische printer print zwart-wit op printkopbreedte. Lever dus een
# monochroom PNG aan, niet breder dan de printkop: 384 pixels bij een 58mm-rol,
# 576 bij 80mm. Breder wordt afgekapt, kleur wordt modder.
#
# De rest van wat er op de bon staat — bedrijfsnaam, KvK, BTW-nummer, adres en
# een afsluitende tekst — vul je in via /admin -> Kassabon. Laat je iets leeg,
# dan wordt die regel niet geprint.

# --- Netwerk ---
# Hostnaam: schermen openen https://<POS_HOSTNAME>.local (web-app) en de
# pi-bridge draait op https://<POS_HOSTNAME>.local:3001
POS_HOSTNAME=hopbites

# INTERNET IN DE TRUCK — hier valt niets in te stellen, en dat is de bedoeling.
#
# Sluit een telefoon met een USB-kabel aan en zet USB-tethering aan
# (Android: Instellingen -> Verbindingen -> Mobiele hotspot en tethering ->
# USB-tethering. iPhone: Persoonlijke hotspot, en tik "Vertrouwen" aan).
# De Pi pakt dat vanzelf op, houdt zijn eigen WiFi-netwerk gewoon in de lucht,
# en de telefoon laadt ondertussen op. Werkt op elk terrein hetzelfde.
#
# Kijk in /admin of het internet er echt is: daar staat via welke verbinding
# hij binnenkomt, of myPOS bereikbaar is, en of er een inlogpagina tussen zit.
# Zonder app: STATUS.txt in deze map toont hetzelfde bij het opstarten.
#
# Onderstaande AP/WiFi-instellingen gaan over het netwerk vóór de schermen —
# niet over de internetverbinding.

# Optie A — EIGEN ACCESS POINT (aanbevolen): de Pi zendt zelf een WiFi-netwerk
# uit waar de kassa/KDS/CFD-schermen mee verbinden. AP_PASS minimaal 8 tekens.
# Let op: wlan0 kan niet tegelijk AP zijn én met een ander WiFi verbinden.
# Daarom komt het internet via USB-tethering of een netwerkkabel binnen, en
# niet via WiFi.
AP_SSID=
AP_PASS=
# Geavanceerd: band bg=2.4GHz (default, beste bereik) of a=5GHz; kanaal.
AP_BAND=bg
AP_CHANNEL=6
AP_IP=10.42.0.1

# Optie B — verbind met een bestaand WiFi-netwerk (genegeerd als AP_SSID
# gezet is). Alleen zinnig op een vaste locatie met je eigen WiFi. Op gast- of
# terrein-WiFi werkt dit meestal níet: die netwerken blokkeren verkeer tussen
# apparaten onderling, en dan bereiken de schermen de Pi niet meer.
WIFI_SSID=
WIFI_PASS=
WIFI_COUNTRY=NL

# --- Kiosk (optioneel): URL die fullscreen op de HDMI-uitgang opent ---
# Bijv. het lokale CFD: https://hopbites.local/cfd  — leeg = geen kiosk.
KIOSK_URL=

# --- AI-functies in /admin (optioneel) ---
ANTHROPIC_API_KEY=

# --- Remote beheer (optioneel) ---
# 1 = Raspberry Pi Connect aan: remote shell via https://connect.raspberrypi.com,
# ook buiten je eigen netwerk. Eenmalig koppelen na de eerste boot:
#   ssh hopbites@hopbites.local  ->  rpi-connect signin
# LET OP: Pi Connect is een clouddienst — de signin én de verbinding werken
# alleen als de Pi zelf internet heeft. In AP-modus betekent dat: uplink via
# de ethernet-poort of USB-tethering (het AP blijft gewoon werken). Zit je
# op het AP-netwerk, dan heb je Pi Connect niet nodig: ssh hopbites@hopbites.local
ENABLE_RPI_CONNECT=0

# --- Geavanceerd (optioneel) ---
# Extra toegestane PWA-origins, komma-gescheiden. De lokale web-app
# (https://<POS_HOSTNAME>.local) is altijd al toegestaan.
ALLOWED_ORIGINS=
# Beperk mDNS tot één interface (bijv. wlan0) zodat er nooit op een
# tethered/WAN-interface geadverteerd wordt. Leeg = alle interfaces.
MDNS_INTERFACE=
SENTRY_DSN=
