# Pi-bridge env — lives ONLY on the Pi. Never bundle to Vercel / PWA.
# After populating, copy to /etc/pi-bridge/env on the Pi.

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# This Pi belongs to one venue
ORG_ID=00000000-0000-0000-0000-000000000001
VENUE_ID=00000000-0000-0000-0000-000000000010

# Supabase service role — backend-only writes (audit_log, outbox flush)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tablet pairing JWT (HS256). 32+ chars. Generate: openssl rand -hex 32
PI_BRIDGE_PAIRING_SECRET=
PI_BRIDGE_ADMIN_TOKEN=

# myPOS — never leaves the Pi.
# off   = PIN disabled (bridge still boots)
# lan   = drive the terminal directly over IPP on the local network. No uplink
#         needed on the Pi at all; the card is authorised over the terminal's
#         own SIM. This is the route the foodtruck runs.
# cloud = ePOS API via the myPOS API Gateway. Needs an uplink on the Pi for the
#         API call; the card itself is still authorised over the terminal's SIM.
MYPOS_TRANSPORT=off

# Below this the kassa offers cash instead of PIN, in cents. One cent came back
# from the bank as APPROVAL=58 while one euro went through, so this sits on the
# amount we have proof for. 0 disables the check.
MYPOS_MIN_AMOUNT_CENTS=100

# usb only: the terminal on a cable instead of the network. Set the device to
# POSLink Manager -> Settings -> Change connection type -> USB. Find the path
# with `ls -l /dev/serial/by-id/` — that name is stable, /dev/ttyACM0 is not.
MYPOS_TERMINAL_SERIAL=
MYPOS_TERMINAL_BAUD=115200

# lan only: where the terminal listens. Set a static IP on the device itself,
# and read the port from POSLink Manager -> Settings -> Edit port (7901 on our
# Ultra, 7900 on some others).
MYPOS_TERMINAL_HOST=
MYPOS_TERMINAL_PORT=7901

# cloud only. https://demo-api-gateway.mypos.com while testing
MYPOS_GATEWAY_URL=https://api-gateway.mypos.com

# Partner Portal -> Integrations -> Summary / Generate API Credentials
MYPOS_PARTNER_ID=
MYPOS_APPLICATION_ID=
MYPOS_INTEGRATION_CLIENT_ID=
MYPOS_INTEGRATION_CLIENT_SECRET=

# Partner Portal -> Merchants
MYPOS_MERCHANT_CLIENT_ID=
MYPOS_MERCHANT_CLIENT_SECRET=

MYPOS_TID=
MYPOS_OPERATOR_CODE=1

# Thermal printer (TCP on LAN)
PRINTER_NETWORK_ADDR=192.168.1.50
PRINTER_TYPE=star

# SQLite outbox + paired-tablets file path
SQLITE_PATH=/data/pi-bridge.sqlite

# TLS (mkcert in dev, self-signed or Let's Encrypt in prod)
TLS_CERT_PATH=/tls/cert.pem
TLS_KEY_PATH=/tls/key.pem

# Operational flags
DISABLE_MDNS=false
SIMULATE_SUPABASE_OUTAGE=false

# Sentry (errors + tracing) — leave blank to keep the SDK a no-op
SENTRY_DSN=
